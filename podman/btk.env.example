# Copy to /etc/btk/btk.env (referenced by EnvironmentFile= in the .container
# quadlet files here) and fill in real values. Unlike .env.example at the repo
# root (used for local `uv run` / `podman compose` dev), BTK_DB_HOST is set
# directly in each .container file (127.0.0.1) since pod containers share a
# network namespace -- don't duplicate it here.

BTK_DB_NAME=btk
BTK_DB_USER=btk
BTK_DB_PASSWORD=btk          # must match POSTGRES_PASSWORD in btk-db.container

BTK_DISCORD_TOKEN=
BTK_DISCORD_COMMAND_PREFIX=!

BTK_DUMP_LIVE_BASE_URL=https://game.planetarion.com/botfiles
BTK_SHIPS_LIVE_URL=https://game.planetarion.com/api.pl?stats
BTK_GAME_STATUS_URL=https://www.planetarion.com/games/status/game/
