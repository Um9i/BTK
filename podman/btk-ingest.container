[Unit]
Description=BTK live tick ingest (fetches + processes the latest PA botfiles)
After=btk-db.service
Requires=btk-db.service

[Container]
Image=localhost/btk:latest
Pod=btk.pod
Environment=BTK_DB_HOST=127.0.0.1
EnvironmentFile=/etc/btk/btk.env
Exec=uv run btk-ingest live

[Service]
Type=oneshot
RemainAfterExit=no
