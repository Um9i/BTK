# Copy to .env and fill in real values. All vars are prefixed BTK_ (see btk/config.py).

BTK_DB_HOST=localhost
BTK_DB_PORT=5432
BTK_DB_NAME=btk
BTK_DB_USER=btk
BTK_DB_PASSWORD=btk

BTK_DISCORD_TOKEN=
BTK_DISCORD_COMMAND_PREFIX=!
BTK_DISCORD_APPLICATION_ID=
BTK_DISCORD_PUBLIC_KEY=

# Live game botfiles/ship stats/status (PA ticks 1 minute past every hour;
# round number is read from the status page, not configured here)
BTK_DUMP_LIVE_BASE_URL=https://game.planetarion.com/botfiles
BTK_SHIPS_LIVE_URL=https://game.planetarion.com/api.pl?stats
BTK_GAME_STATUS_URL=https://www.planetarion.com/games/status/game/

BTK_API_HOST=0.0.0.0
BTK_API_PORT=8000
